{
  "routes": [
    {
      "src": "/admin(.*)",
      "status": 307,
      "headers": {
        "Location": "https://pickadmin.vercel.app/"
      }
    },
    {
      "src": "/api/shipments/(?<id>[^/]+)",
      "dest": "/api/shipments.js?id=$id"
    },
    {
      "src": "/api/shipments",
      "dest": "/api/shipments.js"
    },
    {
      "src": "/api/auth/register",
      "dest": "/api/auth.js?action=register"
    },
    {
      "src": "/api/auth/google",
      "dest": "/api/auth.js?action=google"
    },
    {
      "src": "/api/auth/google-phone",
      "dest": "/api/auth.js?action=google-phone"
    },
    {
      "src": "/api/check-user-email",
      "dest": "/api/auth.js?action=check-user-email"
    },
    {
      "src": "/api/analyze-image",
      "dest": "/api/analyze.js?type=image"
    },
    {
      "src": "/api/analyze-link",
      "dest": "/api/analyze.js?type=link"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/nri-requests",
      "dest": "/api/nri-requests.js"
    },
    {
      "src": "/api/estimate-request",
      "dest": "/api/estimate-request.js"
    },
    {
      "src": "/api/service-requests",
      "dest": "/api/service-requests.js"
    },
    {
      "src": "/api/estimate",
      "dest": "/api/estimate.js"
    },
    {
      "src": "/api/slots/availability",
      "dest": "/api/slots-availability.js"
    },
    {
      "src": "/api/send-email",
      "dest": "/api/send-email.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
